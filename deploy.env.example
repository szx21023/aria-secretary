# 複製成 deploy.env（已被 .gitignore 忽略），填入你的值。
# deploy.sh 會自動讀取。

GCP_PROJECT=your-gcp-project-id
GCP_ACCOUNT=you@example.com

# 以下可省略，會用預設值
# GCP_REGION=asia-east1
# BACKEND_SERVICE=aria-backend
# FRONTEND_SERVICE=aria-frontend

# 接 Cloud SQL 時填實例連線名稱（PROJECT:REGION:INSTANCE），deploy.sh 會用
# --add-cloudsql-instances 掛上；DATABASE_URL 本身放 backend/.env。留空＝沿用容器內 SQLite。
# CLOUDSQL_INSTANCE=dataops-317513:asia-east1:aria-db
