# 複製成 .env 並填入你的金鑰
ANTHROPIC_API_KEY=sk-ant-...

# SQLite（dev 預設）。要切 Postgres 時改這裡。
DATABASE_URL=sqlite+aiosqlite:///./aria.db
# 接 Cloud SQL (Postgres) — 兩種連線型態：
#   本機（經授權 IP / Cloud SQL Auth Proxy，走 TCP）：
#     DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/DBNAME  # pragma: allowlist secret
#   Cloud Run（掛 --add-cloudsql-instances，走 unix socket）：
#     DATABASE_URL=postgresql+asyncpg://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE  # pragma: allowlist secret
# 部署時 deploy.sh 會讀這行注入 Cloud Run；同時在 deploy.env 設 CLOUDSQL_INSTANCE。

# 前端 dev server，允許 CORS
CORS_ORIGINS=http://localhost:5173

# 應用時區（seed 與「現在時間」相關顯示用）
APP_TZ=Asia/Taipei

# ── 網頁登入（必填，否則 fail-closed：登入回 503、所有 /api/* 回 401）──────
# APP_PASSWORD：網頁登入密碼。限 ASCII 可見字元（不可中文/emoji），且不可含 '@'。
APP_PASSWORD=
# AUTH_SECRET：JWT 簽章密鑰，建議 ≥32 bytes 隨機值：
#   python -c 'import secrets; print(secrets.token_hex(32))'
AUTH_SECRET=
# 簽發 token 的有效天數（選填，預設 7）
# AUTH_TOKEN_DAYS=7

# ── LINE 串接（選用）──────────────────────────────────────────
# 兩者皆填才會啟用：在 LINE Developers Console 的 Messaging API channel 取得。
# 缺任一則 webhook 不掛、推播不啟動，純本機/網頁模式照常運作。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 推播收件人。留空＝自動用最後一個跟 bot 講過話的人（從 webhook 捕捉）。
LINE_PUSH_USER_ID=
# 對話授權白名單（逗號分隔的 LINE userId）。留空＝不限制（任何人都能對話、讀到你的行程，
# 啟動時會警告）。建議加好友後從後端 log 取得自己的 userId 填進來鎖定。
LINE_ALLOWED_USER_IDS=

# 行程「即將開始」提前幾分鐘推播
EVENT_REMINDER_LEAD_MIN=10
# 推播排程掃描間隔（秒）；設 0 停用推播但保留對話
NOTIFIER_INTERVAL_SEC=60
